<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BeatDrum" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/bd_primary</item>
        <item name="colorPrimaryVariant">@color/bd_primary_dark</item>
        <item name="colorOnPrimary">@color/bd_on_primary</item>
        <item name="colorSecondary">@color/bd_accent</item>
        <item name="colorSecondaryVariant">@color/bd_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/bd_primary_dark</item>
        <item name="android:windowBackground">@color/bd_bg_top</item>
        <item name="colorControlActivated">@color/bd_primary</item>
    </style>

    <!-- 툴바를 어두운 오버레이로 → 햄버거 아이콘/타이틀이 흰색으로 보이게 -->
    <style name="Theme.BeatDrum.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <!-- 라운드 강조 버튼 스타일 (시작/탭 등) -->
    <style name="BdButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="backgroundTint">@color/bd_primary</item>
    </style>
</resources>
