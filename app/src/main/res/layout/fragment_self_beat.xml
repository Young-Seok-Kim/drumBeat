<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bd_bg_gradient"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="12dp"
        android:text="@string/measure_bpm"
        android:textColor="@color/bd_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 결과 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bd_card"
        android:elevation="2dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/textViewBpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/selfbeat_bpm_placeholder"
            android:textColor="@color/bd_primary"
            android:textSize="48sp"
            android:textStyle="bold"
            tools:text="120 BPM" />

        <TextView
            android:id="@+id/textViewInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/selfbeat_4click"
            android:textColor="@color/bd_text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonApply"
            style="@style/BdButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/selfbeat_apply_to_metronome"
            android:visibility="invisible"
            tools:visibility="visible" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 큰 탭 버튼. 손가락으로 치기 쉽게 화면 아래쪽에 크게 -->
    <Button
        android:id="@+id/buttonTap"
        style="@style/BdButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/selfbeat_tap"
        android:textSize="22sp"
        android:paddingTop="56dp"
        android:paddingBottom="56dp" />

</LinearLayout>
