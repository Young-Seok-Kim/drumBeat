<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/metronome_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bd_metronome_bar"
    android:elevation="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- 박자표 · 음표 · BPM 한 줄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spinnerTimeSignature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:entries="@array/time_signature_array" />

        <Spinner
            android:id="@+id/spinnerNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:entries="@array/note_type_array" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textViewBpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bpm_label"
            android:textColor="@color/bd_text_secondary"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editTextBpm"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:inputType="number"
            android:text="60"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/bd_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:importantForAutofill="no" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekBarBpm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:min="30"
        android:max="240"
        android:progress="60"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/buttonStartStop"
        style="@style/BdButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/start" />

</LinearLayout>
